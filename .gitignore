# Data files are generated or downloaded, live in object storage, and are
# never committed. The metadata under catalog/ IS committed; only the bytes it
# describes are not. Git keeps every version of a binary forever, so one large
# file committed once is paid for by every clone from then on.
*.parquet
*.pmtiles
*.tif
*.tiff
*.zarr/
*.copc.laz
*.laz
*.geojsonl
*.gpkg
*.shp
*.zip

# Staged data (uploaded by tools/upload_data.py) and build scratch.
staging-data/
.cache/

# Pipeline scratch on rails: sbatch logs, spools, temp dirs.
pipeline/*.out
pipeline/tmp-*/
pipeline/staged/
pipeline/manifest.txt
*.out

# Secrets
.env
.env.*
!.env.example

# OS, editor, and tooling noise
.DS_Store
__pycache__/
*.pyc
.venv/
.ruff_cache/
.superpowers/
