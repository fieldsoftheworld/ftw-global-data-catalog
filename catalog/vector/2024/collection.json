      "description": "Mean model field probability inside the parcel, × 100 rounded (0–100)."
    },
    {
      "name": "determination:datetime",
      "type": "timestamp",
      "description": "The prediction year's UTC start marker, constant per year ([fiboa 0.3.0](https://fiboa.org/specification/v0.3.0/schema.yaml))."
    },
    {
      "name": "determination:method",
      "type": "string",
      "description": "Constant `auto-imagery` ([fiboa 0.3.0](https://fiboa.org/specification/v0.3.0/schema.yaml))."
    }
